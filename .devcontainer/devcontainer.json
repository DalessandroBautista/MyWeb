{
	"name": "Bautista Personal Website",
	"build": {
		"dockerfile": "Dockerfile",
		"args": {
			"VARIANT": "20-bullseye"
		}
	},
	"customizations": {
		"vscode": {
			"settings": {
				"editor.formatOnSave": true,
				"editor.defaultFormatter": "esbenp.prettier-vscode"
			},
			"extensions": [
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode",
				"bradlc.vscode-tailwindcss"
			]
		}
	},
	"forwardPorts": [5173],
	"remoteUser": "node"
}
